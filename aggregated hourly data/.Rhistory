combineSites <- function(df1,df2) {
#input: two dataframes of hourly sensor data
#first input will have all its values saved, second input will have some removed during the left join
#output df with combined site data, with na and nonzero values removed
#future improvements: potentially change left join to a different kind of join - need to see how
#left join causes some values to be removed from one of the dfs and how this influences the graph
#this code was taken from Keiras code for making this graphs so there may be some redundancy
sites_combined <- df1 %>%
left_join(df2, by = "date")
col3 <- names(sites_combined)[3]
col4 <- names(sites_combined)[4]
sites_combined <- sites_combined %>%
filter(!is.na(.data[[col3]])) %>%
filter(!is.na(.data[[col4]])) %>%
filter(col3 > 0 & col4 > 0) %>%
mutate(date = parse_date_time(date, orders = c("ymd HMS", "ymd"), tz = "MST")) %>%
mutate(date = lubridate::floor_date(date, "hour")) %>%
mutate(date_notime = as.Date(date)) %>%
group_by(date, date_notime) %>%
summarise(col3 = mean(col3, na.rm = TRUE),
col4 = mean(col4, na.rm = TRUE))
return(sites_combined)
}
